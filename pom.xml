<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		POM raiz: agregador de todos los modulos y padre comun.
		Hereda de spring-boot-starter-parent para tener gestionadas las versiones de todo el
		ecosistema (Spring, Kafka, Flyway, Jackson 3, Testcontainers...). Ver docs/adr/0018.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>es.gastos</groupId>
	<artifactId>gastos2</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Gastos2</name>
	<description>Back de Gastos como microservicios: DDD, Clean Architecture y Hexagonal</description>

	<modules>
		<module>compartido/kernel</module>
		<module>compartido/pruebas</module>
		<module>compartido/contratos</module>
		<module>compartido/web</module>
		<module>compartido/mensajeria</module>
		<module>servicios/identidad</module>
		<module>servicios/movimientos</module>
		<module>servicios/clasificacion</module>
		<module>servicios/importacion</module>
		<module>servicios/gateway</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<poi.version>5.5.1</poi.version>
		<commons-io.version>2.21.0</commons-io.version>
		<archunit.version>1.5.1</archunit.version>
		<springdoc.version>3.1.1</springdoc.version>
		<!-- JVM de tests acotadas: el portátil comparte memoria con Docker (compose + Testcontainers) -->
		<argLine>-Xmx768m -XX:TieredStopAtLevel=1 -XX:+UseSerialGC</argLine>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Modulos internos -->
			<dependency>
				<groupId>es.gastos</groupId>
				<artifactId>kernel</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>es.gastos</groupId>
				<artifactId>contratos</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>es.gastos</groupId>
				<artifactId>web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>es.gastos</groupId>
				<artifactId>mensajeria</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>es.gastos</groupId>
				<artifactId>pruebas</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Terceros no gestionados por Spring Boot -->
			<dependency>
				<groupId>org.apache.poi</groupId>
				<artifactId>poi-ooxml</artifactId>
				<version>${poi.version}</version>
			</dependency>
			<!-- POI y su commons-compress piden versiones distintas; se fija la mayor (regla dependencyConvergence) -->
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>${commons-io.version}</version>
			</dependency>
			<dependency>
				<groupId>com.tngtech.archunit</groupId>
				<artifactId>archunit-junit5</artifactId>
				<version>${archunit.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>requisitos-del-entorno</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<dependencyConvergence/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- *Test: rapidos, sin Docker (surefire). *IT: con Testcontainers (failsafe). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
